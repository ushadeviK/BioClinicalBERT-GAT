# Python Virtual Environments
.venv/
venv/
env/
ENV/
bin/
lib/
include/

# Python caching
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Local environment configuration files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secrets and credentials
secrets/
*.pem
*.key
*.cert
gpg.key

# Research clinical data (highly sensitive - MIMIC, patient data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
*.csv
*.parquet
*.jsonl
*.xlsx
*.tsv

# Large trained models and checkpoints
models/checkpoints/*
!models/checkpoints/.gitkeep
models/final/*
!models/final/.gitkeep
*.bin
*.pth
*.pt
*.h5
*.ckpt
*.onnx
*.pb
*.weights
*.model

# Logs
*.log
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Frontend dependencies and builds
node_modules/
dist/
dist-ssr/
build/
out/
.next/
*.local

